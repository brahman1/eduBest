DATABASE_URL=postgresql://edubest:edubest_local_only@127.0.0.1:5448/edubest
PORT=4200
WEB_URL=http://127.0.0.1:3100
ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://127.0.0.1:8095
NODE_ENV=development
SMTP_HOST=127.0.0.1
SMTP_PORT=1038
SMTP_FROM=EduBest <contact@localhost>
SMTP_USER=
SMTP_PASSWORD=
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://127.0.0.1:4200
# Pour un téléphone sur le réseau local, définir dans mobile/.env.local :
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4200/api
# EXPO_PUBLIC_WEB_URL=http://YOUR_LAN_IP:3100
# Sinon Expo déduit l’adresse de la machine de développement.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Secret serveur aléatoire (32 caractères minimum), jamais dans EXPO_PUBLIC/NEXT_PUBLIC.
# Générer avec node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECURITY_ENCRYPTION_KEY=

# Exclusivement pour la démonstration locale ; laisser false en exploitation.
EDUBEST_DEMO_ENABLED=false
# Le premier compte est créé par npm run setup, jamais via le site.
EDUBEST_ADMIN_EMAIL=
EDUBEST_ADMIN_NAME=
EDUBEST_ADMIN_PASSWORD=
