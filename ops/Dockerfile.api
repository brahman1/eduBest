FROM node:26.13.1-bookworm-slim AS build
WORKDIR /app
COPY package*.json ./
COPY api/package.json api/package.json
COPY shared/package.json shared/package.json
RUN npm ci --workspace api --workspace shared
COPY shared shared
COPY api api
COPY scripts/setup-school.mjs scripts/setup-school.mjs
RUN npm run build -w shared && npm run build -w api
RUN npm prune --omit=dev --workspace api --workspace shared
RUN mkdir -p api/node_modules
FROM node:26.13.1-bookworm-slim
ENV NODE_ENV=production PORT=4200
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/shared ./shared
COPY --from=build /app/api/package.json ./api/package.json
COPY --from=build /app/api/dist ./api/dist
COPY --from=build /app/api/node_modules ./api/node_modules
COPY --from=build /app/api/migrations ./api/migrations
COPY --from=build /app/scripts/setup-school.mjs ./scripts/setup-school.mjs
USER node
WORKDIR /app/api
EXPOSE 4200
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:4200/api/public/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","dist/main.js"]
