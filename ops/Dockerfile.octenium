FROM node:26.13.1-bookworm-slim AS api-build
WORKDIR /app
COPY package*.json ./
COPY api/package.json api/package.json
COPY shared/package.json shared/package.json
RUN npm ci --workspace api --workspace shared
COPY shared shared
COPY api api
RUN npm run build -w shared && npm run build -w api && npm prune --omit=dev --workspace api --workspace shared
RUN cp -aL node_modules node_modules-portable
RUN if [ -d api/node_modules ]; then cp -aL api/node_modules api-node-modules-portable; else mkdir api-node-modules-portable; fi

FROM node:26.13.1-bookworm-slim AS web-build
WORKDIR /app
ARG EDUBEST_PUBLIC_SITE_ONLY=false
ARG EDUBEST_API_ORIGIN=https://api.edubest.dz
ENV NEXT_PUBLIC_EDUBEST_PUBLIC_SITE_ONLY=$EDUBEST_PUBLIC_SITE_ONLY
ENV NEXT_TELEMETRY_DISABLED=1 API_INTERNAL_URL=$EDUBEST_API_ORIGIN
COPY package*.json ./
COPY web/package.json web/package.json
COPY shared/package.json shared/package.json
RUN npm ci --workspace web --workspace shared
COPY shared shared
COPY web web
RUN npm run build -w shared && npm run build -w web
RUN cp -aL web/.next/standalone web/.next/portable

FROM scratch AS export
COPY --from=api-build /app/node_modules-portable /runtime/api/node_modules
COPY --from=api-build /app/api/dist /runtime/api/api/dist
COPY --from=api-build /app/api/migrations /runtime/api/api/migrations
COPY --from=api-build /app/api-node-modules-portable /runtime/api/api/node_modules
COPY --from=api-build /app/shared /runtime/api/shared
COPY ops/octenium /runtime/api/ops/octenium
COPY scripts/setup-school.mjs scripts/backup.mjs scripts/backup-crypto.mjs /runtime/api/scripts/
COPY --from=web-build /app/web/.next/portable /runtime/web
COPY --from=web-build /app/web/.next/static /runtime/web/web/.next/static
COPY --from=web-build /app/web/public /runtime/web/web/public
COPY ops/octenium/web-entry.cjs /runtime/web/entry.cjs
COPY ops/octenium/runtime-check.cjs ops/octenium/public.json /runtime/web/
COPY ops/octenium/wrappers/api/app.js /applications/edubest-api/app.js
COPY ops/octenium/wrappers/web/app.js /applications/edubest-web/app.js

COPY ops/octenium/database/schema-empty.sql /database/schema-empty.sql
COPY ops/octenium/api.env.example /private/api.env.example
COPY ops/octenium/DEPLOIEMENT.md /LIRE-AVANT-DEPLOIEMENT.md

FROM scratch AS public-site
COPY --from=web-build /app/web/.next/portable /runtime/web
COPY --from=web-build /app/web/.next/static /runtime/web/web/.next/static
COPY --from=web-build /app/web/public /runtime/web/web/public
COPY ops/octenium/web-public-entry.cjs /runtime/web/entry.cjs
COPY ops/octenium/runtime-check.cjs ops/octenium/public.json /runtime/web/
COPY ops/octenium/wrappers/web/app.js /applications/edubest-web/app.js

FROM export AS release

# Compile-time rewrites belong to one environment. This target exports only the web runtime.
FROM scratch AS web-runtime
COPY --from=web-build /app/web/.next/portable /runtime/web
COPY --from=web-build /app/web/.next/static /runtime/web/web/.next/static
COPY --from=web-build /app/web/public /runtime/web/web/public
COPY ops/octenium/web-entry.cjs /runtime/web/entry.cjs
COPY ops/octenium/runtime-check.cjs ops/octenium/public.json /runtime/web/
