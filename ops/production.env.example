# Copy to ops/production.env; never commit it.
DOMAIN=
TLS_EMAIL=
# Generate a long random hexadecimal password (URL-safe, 48 characters minimum).
POSTGRES_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SECURITY_ENCRYPTION_KEY=
EDUBEST_ADMIN_EMAIL=
EDUBEST_ADMIN_NAME=
EDUBEST_ADMIN_PASSWORD=
SCHOOL_LEGAL_NAME=
SCHOOL_ADDRESS=
SCHOOL_CONTACT_EMAIL=
# Optional; defaults to SCHOOL_CONTACT_EMAIL.
SCHOOL_PRIVACY_EMAIL=
# Document the real hosting, email/push providers and any international transfers.
DATA_HOSTING_DESCRIPTION=
DATA_RETENTION_POLICY=
DATA_PROCESSING_BASIS=
EDUBEST_BACKUP_INTERVAL_SECONDS=86400
# Restoration is only permitted to a new empty edubest_restore_* database.
EDUBEST_RESTORE_DATABASE_URL=
